{
  "permissions": {
    "allow": [
      "Bash(vendor/bin/sail artisan test:*)",
      "Bash(vendor/bin/sail composer test:*)",
      "Bash(vendor/bin/sail composer lint:*)",
      "Bash(vendor/bin/sail composer analyse:*)",
      "Bash(vendor/bin/sail composer check:*)",
      "Bash(vendor/bin/sail composer audit:*)",
      "Bash(vendor/bin/sail bin pint:*)",
      "Bash(vendor/bin/sail artisan route:list:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "mcp__laravel-boost"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.backup)",
      "Read(.env.production)"
    ]
  },
  "enabledMcpjsonServers": [
    "laravel-boost"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-files.sh",
            "args": []
          }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": true,
    "excludedCommands": [
      "vendor/bin/sail *",
      "./vendor/bin/sail *"
    ],
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com"
      ]
    }
  }
}
